{
  "name": "flownote",
  "version": "0.5.25",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:release",
    "build:sdk-vendor": "node scripts/build-sdk-vendor.mjs",
    "build:release": "npm run check:bundled-skills && npm run build:sdk-vendor && node scripts/build-release.mjs",
    "check:bundled-skills": "node scripts/check-bundled-skill-references.js",
    "guard:repo-hygiene": "node scripts/guard-repo-hygiene.js",
    "guard:source-of-truth": "node scripts/guard-source-of-truth.js",
    "guard:runtime-contract": "node scripts/guard-runtime-contract.js",
    "verify:version-sync": "node scripts/verify-version-sync.js",
    "check:submission": "node scripts/check-submission-readiness.mjs",
    "check:release-bundle": "node scripts/check-release-bundle.cjs",
    "check": "node --check main.js",
    "check:runtime": "find runtime -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check:file-size": "node scripts/guard-file-size.js",
    "test": "find tests/runtime -type f -name '*.test.js' -print0 | xargs -0 node --test",
    "ci": "npm run guard:repo-hygiene && npm run guard:source-of-truth && npm run guard:runtime-contract && npm run verify:version-sync && npm run check:bundled-skills && npm run check && npm run check:runtime && npm run check:file-size && npm run test",
    "release:check": "npm run ci && npm run check:release-bundle && npm run check:submission",
    "pretest": "npm run build:release"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.2.16",
    "yaml": "^2.9.0"
  }
}
